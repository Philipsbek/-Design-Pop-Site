---
const plans = [
  {
    name: 'Free',
    price: '$0',
    cadence: 'forever',
    blurb: 'Everything you need to claim your link and go live today.',
    features: ['1 published site', 'Core blocks & themes', 'pop.site/you address', 'Basic analytics'],
    cta: 'Claim your link',
    featured: false,
  },
  {
    name: 'Pro',
    price: '$9',
    cadence: 'per month',
    blurb: 'For creators and shops ready to sell, grow and get serious.',
    features: [
      'Everything in Free',
      'Store & payments',
      'Custom domain',
      'Realtime analytics',
      'Remove Pop Site badge',
    ],
    cta: 'Start Pro',
    featured: true,
  },
  {
    name: 'Studio',
    price: '$29',
    cadence: 'per month',
    blurb: 'For teams running many sites and clients from one roof.',
    features: ['Everything in Pro', 'Up to 25 sites', 'Team seats', 'Priority support', 'Client hand-off'],
    cta: 'Start Studio',
    featured: false,
  },
];
---

<section class="section pricing" id="pricing">
  <div class="container">
    <div class="section-head">
      <h2 class="heading" data-reveal>Fair pricing. No pop-ups.</h2>
      <p class="subheading" data-reveal style="--reveal-delay:60ms">
        Start free, upgrade when you outgrow it. Cancel any time — your site stays live.
      </p>
    </div>

    <div class="plans">
      {
        plans.map((p, i) => (
          <article
            class={`plan ${p.featured ? 'plan--featured' : ''}`}
            data-reveal
            style={`--reveal-delay:${i * 80}ms`}
          >
            {p.featured && <span class="plan__flag">Most popular</span>}
            <h3 class="plan__name">{p.name}</h3>
            <div class="plan__price">
              <span class="plan__amount">{p.price}</span>
              <span class="plan__cadence">/ {p.cadence}</span>
            </div>
            <p class="plan__blurb">{p.blurb}</p>
            <a
              href="#claim"
              class={`btn ${p.featured ? 'btn--primary' : 'btn--secondary'} plan__cta`}
            >
              {p.cta}
            </a>
            <ul class="plan__features">
              {p.features.map((f) => (
                <li>
                  <span class="plan__tick" aria-hidden="true">✓</span>
                  {f}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-20);
    align-items: start;
  }

  .plan {
    background: #fff;
    border: 1px solid var(--color-mist);
    border-radius: var(--radius-feature-cards);
    padding: var(--spacing-36) var(--spacing-24);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease;
  }

  .plan:hover {
    transform: translateY(-4px);
    border-color: var(--color-charcoal);
  }

  .plan--featured {
    border-color: var(--color-charcoal);
    background: var(--color-wash-blue);
  }

  .plan__flag {
    position: absolute;
    top: var(--spacing-24);
    right: var(--spacing-24);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-signal-blue);
    background: #fff;
    border: 1px solid var(--color-signal-blue);
    border-radius: 9999px;
    padding: 4px 10px;
  }

  .plan__name {
    font-size: var(--text-subheading);
    font-weight: 500;
    color: #000;
  }

  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: var(--spacing-16);
  }

  .plan__amount {
    font-size: 56px;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    color: #000;
  }

  .plan__cadence {
    font-size: 14px;
    color: var(--color-slate);
  }

  .plan__blurb {
    margin-top: var(--spacing-16);
    font-size: 14px;
    line-height: 1.5;
    color: var(--color-granite);
    min-height: 42px;
  }

  .plan__cta {
    margin-top: var(--spacing-24);
    width: 100%;
  }

  .plan__features {
    list-style: none;
    margin-top: var(--spacing-24);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .plan__features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--color-charcoal);
  }

  .plan__tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--color-signal-blue);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    flex: none;
  }

  @media (max-width: 820px) {
    .plans {
      grid-template-columns: 1fr;
      max-width: 420px;
      margin-inline: auto;
    }
  }
</style>
