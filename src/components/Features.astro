---
import PhoneMockup from './PhoneMockup.astro';

const features = [
  {
    eyebrow: 'Build',
    title: 'Start typing. Watch a site appear.',
    body: 'No blank canvas, no fiddly grid. Add a block, drop in your words and photos, and Pop Site handles the spacing, type and rhythm for you. It looks designed because the hard parts already are.',
    points: ['Drag-to-reorder blocks', 'Live preview as you type', 'One-tap themes'],
    template: 'studio',
    seed: 'feat-build',
    align: 'left',
  },
  {
    eyebrow: 'Sell',
    title: 'Take payment without leaving the page.',
    body: 'Turn any block into a product, a booking or a tip jar. Checkout is built in, cards clear on day one, and every sale lands straight in your inbox and your dashboard.',
    points: ['Cards, wallets & Buy-now', 'Digital downloads', 'Zero setup fees'],
    template: 'shop',
    seed: 'feat-sell',
    align: 'right',
  },
  {
    eyebrow: 'Grow',
    title: 'See what pops, then do more of it.',
    body: 'Every tap, view and sign-up is counted for you in plain language. Know which link people love, which drop sold out, and where your next fans are coming from.',
    points: ['Realtime click maps', 'Audience insights', 'Weekly recap email'],
    template: 'creator',
    seed: 'feat-grow',
    align: 'left',
  },
];
---

<section class="section features" id="features">
  <div class="container">
    {
      features.map((f) => (
        <div class={`feature feature--${f.align}`}>
          <div class="feature__copy" data-reveal>
            <span class="eyebrow">{f.eyebrow}</span>
            <h2 class="heading feature__title">{f.title}</h2>
            <p class="body feature__body">{f.body}</p>
            <ul class="feature__points">
              {f.points.map((p) => (
                <li>
                  <span class="feature__tick" aria-hidden="true">✓</span>
                  {p}
                </li>
              ))}
            </ul>
          </div>
          <div class="feature__art" data-reveal style="--reveal-delay:120ms">
            <div class="feature__glow" />
            <PhoneMockup
              template={f.template as any}
              photoSeed={f.seed}
              class="feature__phone"
            />
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .features {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-120);
  }

  .feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--spacing-80);
  }

  .feature--right .feature__copy {
    order: 2;
  }

  .feature__title {
    margin-top: var(--spacing-16);
    max-width: 14ch;
  }

  .feature__body {
    margin-top: var(--spacing-20);
    color: var(--color-granite);
    max-width: 46ch;
    font-size: 16px;
    line-height: 1.6;
  }

  .feature__points {
    list-style: none;
    margin-top: var(--spacing-24);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }

  .feature__points li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: var(--color-charcoal);
  }

  .feature__tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-wash-blue);
    color: var(--color-signal-blue);
    font-size: 11px;
    font-weight: 700;
    flex: none;
  }

  .feature__art {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .feature__glow {
    position: absolute;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: var(--color-wash-blue);
    filter: blur(60px);
    opacity: 0.7;
    z-index: 0;
  }

  .feature__art :global(.feature__phone) {
    position: relative;
    z-index: 1;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.14);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .feature__art:hover :global(.feature__phone) {
    transform: translateY(-8px) rotate(-1.5deg);
  }

  @media (max-width: 820px) {
    .feature {
      grid-template-columns: 1fr;
      gap: var(--spacing-40);
      text-align: center;
    }
    .feature--right .feature__copy {
      order: 0;
    }
    .feature__title,
    .feature__body {
      max-width: none;
    }
    .feature__points {
      align-items: center;
    }
    .features {
      gap: var(--spacing-80);
    }
  }
</style>
