<button class="fab" aria-label="Help & chat" data-fab>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M12 3C6.9 3 3 6.4 3 10.6c0 2.4 1.3 4.5 3.3 5.9-.1.9-.5 2.1-1.4 3.1 1.6-.2 3-.8 4-1.6.9.2 1.9.3 3 .3 5.1 0 9-3.4 9-7.6S17.1 3 12 3Z"
      fill="#fff"
    />
  </svg>
</button>

<style>
  .fab {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 60;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--color-charcoal);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.14);
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .fab:hover {
    transform: translateY(-2px) scale(1.05);
    background: #000;
  }

  .fab:active {
    transform: scale(0.96);
  }
</style>

<script>
  const fab = document.querySelector('[data-fab]');
  fab?.addEventListener('click', () => {
    const el = document.getElementById('claim');
    el?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    const input = el?.querySelector('input');
    setTimeout(() => (input as HTMLInputElement | null)?.focus(), 500);
  });
</script>
