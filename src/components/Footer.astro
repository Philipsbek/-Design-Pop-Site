---
const columns = [
  {
    title: 'Product',
    links: ['Sections', 'Templates', 'Pricing', 'Analytics', 'Memberships'],
  },
  {
    title: 'Resources',
    links: ['Blog', 'Help center', 'Guides', 'Changelog', 'Status'],
  },
  {
    title: 'Company',
    links: ['About', 'Careers', 'Press', 'Contact', 'Featured'],
  },
  {
    title: 'Legal',
    links: ['Privacy', 'Terms', 'Cookies', 'Acceptable use'],
  },
];
---

<footer class="footer" id="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand-col">
        <a href="#top" class="footer__brand">pop site<span class="footer__star">*</span></a>
        <p class="footer__tag">One link. Your whole world.</p>
        <div class="footer__socials">
          {['x', 'ig', 'in', 'yt'].map((s) => <a href="#footer" class="footer__social" aria-label={s}>{s}</a>)}
        </div>
      </div>

      <div class="footer__cols">
        {
          columns.map((c) => (
            <div class="footer__col">
              <h4 class="footer__col-title">{c.title}</h4>
              <ul>
                {c.links.map((l) => (
                  <li>
                    <a href="#footer">{l}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="footer__bottom">
      <span class="caption">© 2026 Pop Site, Inc. Made for makers.</span>
      <span class="caption">Built with Astro · Designed in the open.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-mist);
    padding-block: var(--spacing-80) var(--spacing-40);
    margin-top: var(--spacing-40);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1.2fr 2fr;
    gap: var(--spacing-60);
  }

  .footer__brand {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #000;
  }

  .footer__star {
    color: var(--color-signal-blue);
  }

  .footer__tag {
    margin-top: 12px;
    font-size: 14px;
    color: var(--color-granite);
  }

  .footer__socials {
    display: flex;
    gap: 10px;
    margin-top: var(--spacing-20);
  }

  .footer__social {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--color-mist);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 500;
    color: var(--color-charcoal);
    text-transform: uppercase;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .footer__social:hover {
    border-color: #000;
    color: #000;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-24);
  }

  .footer__col-title {
    font-size: 13px;
    font-weight: 500;
    color: #000;
    margin-bottom: var(--spacing-16);
  }

  .footer__col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer__col a {
    font-size: 13px;
    color: var(--color-granite);
    transition: color 0.18s ease;
  }

  .footer__col a:hover {
    color: #000;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-16);
    margin-top: var(--spacing-60);
    padding-top: var(--spacing-24);
    border-top: 1px solid var(--color-mist);
  }

  @media (max-width: 760px) {
    .footer__top {
      grid-template-columns: 1fr;
      gap: var(--spacing-40);
    }
    .footer__cols {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-36);
    }
    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
